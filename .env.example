# EchoWeave gateway
ECHOWEAVE_HOST=127.0.0.1
ECHOWEAVE_PORT=8765
ECHOWEAVE_LOG_LEVEL=INFO
ECHOWEAVE_PERSONA_ROOT=./personas
# Generate a long random value. Never commit the real value.
ECHOWEAVE_CONSENT_SIGNING_KEY=
# Persist signed consent revision/withdrawal high-water marks on the runtime volume.
ECHOWEAVE_CONSENT_STATE_PATH=./runtime/consent-state.json
# Demo-only shared credential. Required before binding beyond localhost when
# SESSION_SIGNING_KEY is unset. Never use this shared token for a real persona.
ECHOWEAVE_ACCESS_TOKEN=
# Required for every non-demo persona. Use it only to sign short-lived,
# subject/persona/capability-scoped session tokens; never send this key to a UI.
ECHOWEAVE_SESSION_SIGNING_KEY=
ECHOWEAVE_SESSION_TOKEN_AUDIENCE=echoweave-rtc
ECHOWEAVE_SESSION_TOKEN_MAX_TTL_SECONDS=300
ECHOWEAVE_SESSION_TOKEN_CLOCK_SKEW_SECONDS=5
ECHOWEAVE_SESSION_REPLAY_CACHE_ENTRIES=65536
# Localhost on ECHOWEAVE_PORT is accepted automatically. Add production origins here.
ECHOWEAVE_ALLOWED_ORIGINS=
# Comma-separated exact proxy IPs/CIDRs. Forwarded headers are ignored unless
# their direct peer matches this allowlist. Never use 0.0.0.0/0 or ::/0.
ECHOWEAVE_TRUSTED_PROXY_IPS=
# Development-only RFC1918/ULA clear-text exception. Public addresses remain
# blocked even when true. Keep false unless an outer boundary is loopback-only.
ECHOWEAVE_ALLOW_INSECURE_PRIVATE_TRANSPORT=false
# Configure both for native HTTPS/WSS, or leave both empty behind a trusted TLS proxy.
ECHOWEAVE_TLS_CERTFILE=
ECHOWEAVE_TLS_KEYFILE=
ECHOWEAVE_ALLOWED_PERSONAS=demo
ECHOWEAVE_MAX_CONNECTIONS_PER_IP=4
ECHOWEAVE_MAX_ACTIVE_SESSIONS=32
ECHOWEAVE_MAX_WS_MESSAGE_BYTES=262144
ECHOWEAVE_MAX_TEXT_CHARS=1000
ECHOWEAVE_MAX_UTTERANCE_SECONDS=60
ECHOWEAVE_MAX_SESSION_SECONDS=1800
# Session lifecycle and bounded WebSocket transport. Tune only after load testing.
ECHOWEAVE_SESSION_START_TIMEOUT_SECONDS=15
ECHOWEAVE_RUNTIME_START_TIMEOUT_SECONDS=30
ECHOWEAVE_SESSION_IDLE_TIMEOUT_SECONDS=300
ECHOWEAVE_WEBSOCKET_SEND_TIMEOUT_SECONDS=5
ECHOWEAVE_WEBSOCKET_SHUTDOWN_TIMEOUT_SECONDS=5
ECHOWEAVE_OUTBOUND_QUEUE_MAX_MESSAGES=128
ECHOWEAVE_OUTBOUND_QUEUE_MAX_BYTES=67108864
ECHOWEAVE_CONTROL_RATE_PER_SECOND=10
ECHOWEAVE_CONTROL_RATE_BURST=20

# Backends: energy|silero_v5
ECHOWEAVE_VAD_BACKEND=energy
# Backends: demo|qwen_local|qwen_http
ECHOWEAVE_ASR_BACKEND=demo
# Backends: demo|deepseek|openai_compatible
ECHOWEAVE_LLM_BACKEND=demo
# Backends: browser|voxcpm_local|voxcpm_http
ECHOWEAVE_TTS_BACKEND=browser
# Backends: client_lipsync|soulx_http
ECHOWEAVE_AVATAR_BACKEND=client_lipsync

# Qwen3-ASR-1.7B
QWEN_ASR_MODEL=Qwen/Qwen3-ASR-1.7B
QWEN_ASR_BASE_URL=http://127.0.0.1:8001/v1
QWEN_ASR_API_KEY=EMPTY

# DeepSeek V4 Flash: set only in the server environment or secret manager.
# If a key has appeared in chat, logs, source control, or an issue, revoke it
# before use and inject a newly generated replacement. Never commit real keys.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_THINKING=disabled

# Generic hosted chat-completions gateway. The URL must use HTTPS. Keep the
# real key in the server environment or a secret manager, never in this file.
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_MODEL=
OPENAI_COMPAT_MAX_TOKENS=800

# VoxCPM2
VOXCPM_MODEL=openbmb/VoxCPM2
VOXCPM_BASE_URL=http://127.0.0.1:8002/v1
VOXCPM_API_KEY=EMPTY
VOXCPM_SAMPLE_RATE=48000
# Use different 32-byte-or-longer signing keys and audiences for each worker.
VOXCPM_WORKER_TOKEN=
VOXCPM_WORKER_AUDIENCE=echoweave-voxcpm-worker
VOXCPM_MAX_INFLIGHT_REQUESTS=2
VOXCPM_REQUEST_BODY_TIMEOUT_SECONDS=30
# A stuck native/model iterator quarantines the worker after this cleanup budget.
VOXCPM_PRODUCER_JOIN_TIMEOUT_SECONDS=10

# Legacy signing-key fallback only. New deployments must leave this empty and
# configure the two distinct worker keys above/below.
MODEL_WORKER_TOKEN=
ECHOWEAVE_WORKER_ASSERTION_TTL_SECONDS=120
ECHOWEAVE_WORKER_ASSERTION_MAX_TTL_SECONDS=300

# SoulX-FlashHead worker
SOULX_BASE_URL=http://127.0.0.1:8003
SOULX_WORKER_TOKEN=
SOULX_WORKER_AUDIENCE=echoweave-soulx-worker
SOULX_MAX_INFLIGHT_REQUESTS=1
SOULX_REQUEST_BODY_TIMEOUT_SECONDS=45
